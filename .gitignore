# Prisma Browser generated artifacts (rebuilt by `yarn gen-pb`).
# Source of truth: guide MDX in src/components/PBPortal/guides and the
# OpenAPI spec in openapi-specs/prisma-browser. These are never edited
# by hand and never committed, so regenerating them touches no committed files.
src/pages/prisma-browser/guide/
src/components/PBPortal/generated/
static/spec/prisma-browser-management.yaml
static/prisma-browser/llms.txt
static/prisma-browser/llms-full.txt
static/prisma-browser/guide-md/

# Prisma Browser authoring and verification tooling is maintained outside this
# repo. These paths are ignored so internal templates, style guides, and the
# API verification harness are never committed to a public repository.
guides-verify/
src/components/PBPortal/**/_TEMPLATE.md
src/components/PBPortal/**/_TEMPLATE.mdx
src/components/PBPortal/**/_VOICE.md
src/components/PBPortal/ANALYTICS.md

# localized Medium feed images (regenerated at build by scripts/feed2json.js)
static/img/blog-feed/

# playwright
.playwright-storage.json
.pw-user-data/

# claude code
.claude/
