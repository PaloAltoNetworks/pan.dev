{{!
  API page template for the Prisma Browser reference ("browsermgmt" instance).
  Copy of the docusaurus-plugin-openapi-docs 5.2.0 default template with two
  additions for operations that carry `x-prisma-browser-preview`:
  the pb-preview sidebar class and the preview banner.
  check-theme-pin.mjs lists this file for re-diffing on a plugin bump.
}}
---
id: {{{id}}}
title: "{{{title}}}"
description: "{{{frontMatter.description}}}"
{{^api}}
sidebar_label: Introduction
{{/api}}
{{#api}}
sidebar_label: "{{{title}}}"
{{/api}}
{{^api}}
sidebar_position: 0
{{/api}}
hide_title: true
{{#api}}
hide_table_of_contents: true
{{/api}}
{{#json}}
api: {{{json}}}
{{/json}}
{{#api.method}}
sidebar_class_name: "{{{api.method}}} api-method{{#api.deprecated}} menu__list-item--deprecated{{/api.deprecated}}{{#api.x-prisma-browser-preview}} pb-preview{{/api.x-prisma-browser-preview}}"
{{/api.method}}
{{#infoPath}}
info_path: {{{infoPath}}}
{{/infoPath}}
custom_edit_url: null
{{#frontMatter.proxy}}
proxy: {{{frontMatter.proxy}}}
{{/frontMatter.proxy}}
{{#frontMatter.hide_send_button}}
hide_send_button: true
{{/frontMatter.hide_send_button}}
{{#frontMatter.show_extensions}}
show_extensions: true
{{/frontMatter.show_extensions}}
{{#frontMatter.mask_credentials_disabled}}
mask_credentials: false
{{/frontMatter.mask_credentials_disabled}}
---

{{#api.x-prisma-browser-preview}}
<div className="pb-preview-banner" role="note"><span className="pb-preview-banner__tag">Preview</span><p className="pb-preview-banner__body">This endpoint is published ahead of general availability. Send the header <code>x-prisma-browser-preview: {{featureName}}</code> on every request, or it returns <code>400</code>. Its shape can still change. See <a href="/prisma-browser/guide/preview-features">Preview features</a> for how to opt in.</p></div>

{{/api.x-prisma-browser-preview}}
{{{markdown}}}
